# PostgreSQL (future integration — not required for v1, CSV files used instead)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bitetracker
DB_USER=bitetracker_user
DB_PASSWORD=changeme

# Random seed for reproducibility
RANDOM_SEED=42

# Django web application
# DJANGO_SECRET_KEY is required whenever DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Google sign-in ("Continue with Google"). Leave blank to hide the button.
# Create an OAuth client (type "Web application") in Google Cloud Console and add the
# redirect URI http://localhost:8000/auth/google/login/callback/ for local testing.
# Never commit real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Account emails (registration received/decided, new requests for administrators, suspension,
# role or school changes). Locally they are printed to the terminal; nothing is sent.
#   console  - print to the terminal (default when DJANGO_DEBUG=True)
#   disabled - record but never send (default when DJANGO_DEBUG=False)
#   smtp     - send via the SMTP settings below
BITETRACKER_EMAIL_DELIVERY=console
# Absolute address used for links in emails (no trailing slash).
BITETRACKER_SITE_URL=http://localhost:8000
# Only needed with BITETRACKER_EMAIL_DELIVERY=smtp. Use a dedicated SMTP credential from your
# email provider - never the Google sign-in client secret. Never commit real values.
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=5
# Controlled test: comma-separated addresses that may receive email. Everyone else's email is
# recorded as "suppressed" and never sent. Set this to your own address before trying smtp locally.
EMAIL_ALLOWED_RECIPIENTS=
# Seconds a web request may spend starting email sends before leaving the rest for the retry command.
EMAIL_REQUEST_BUDGET_SECONDS=10

# Where writable state lives: SQLite DB, trained model + metadata, processed CSV,
# metrics and uploads. Leave blank locally (everything stays in the project folder).
# Production uses /var/lib/bitetracker (see deploy/bitetracker.env.example).
BITETRACKER_STATE_DIR=

# Real Food4Education data, read live from a Google Sheets share link
# ("Anyone with the link" access). Leave blank to use the synthetic dataset.
BITETRACKER_GOOGLE_SHEET_URL=
# The sheet has no cost column; budgeting uses this cost per meal (KSh).
# Leave blank if unknown: the cost is then left empty rather than set to 0.
BITETRACKER_COST_PER_MEAL_KSH=
