# PostgreSQL (future integration — not required for v1, CSV files used instead)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bitetracker
DB_USER=bitetracker_user
DB_PASSWORD=changeme

# Random seed for reproducibility
RANDOM_SEED=42

# Django web application
# DJANGO_SECRET_KEY is required whenever DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
