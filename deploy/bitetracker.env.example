# Production environment for BiteTracker on EC2: /etc/bitetracker/bitetracker.env (NOT in git).
# deploy/scripts/bootstrap.sh creates it from this template on first run (and never overwrites it):
# it generates DJANGO_SECRET_KEY, sets DJANGO_ALLOWED_HOSTS to the instance's public IP and DNS
# name, and switches the HTTPS settings below off until a certificate is installed.
# Format: KEY=value, one per line, no quotes, no spaces around "=".
# Read by systemd (EnvironmentFile=) and by deploy/scripts/*.sh.

# --- Django --------------------------------------------------------------------
DJANGO_DEBUG=False
# Generate with URL-safe characters only (safe for systemd and shell):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Your domain and/or the instance's public DNS name or Elastic IP, comma-separated.
# The FIRST entry is also used as the Host header for local health checks.
DJANGO_ALLOWED_HOSTS=bitetracker.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://bitetracker.example.org

# HTTPS settings for when a certificate is installed (certbot). Over plain http:// (the
# first launch) bootstrap.sh sets DJANGO_SECURE_COOKIES=False, DJANGO_SECURE_SSL_REDIRECT=False
# and DJANGO_SECURE_HSTS_SECONDS=0; otherwise logins fail and pages redirect to https://.
DJANGO_BEHIND_HTTPS_PROXY=True
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=True
# Start small; raise to 31536000 once HTTPS is confirmed working.
DJANGO_SECURE_HSTS_SECONDS=3600

# --- Google sign-in -------------------------------------------------------------
# OAuth client from Google Cloud Console (type "Web application"). Authorised redirect URI:
#   https://bitetracker.xyz/auth/google/login/callback/
# Leave both blank to hide "Continue with Google" (password login keeps working).
# This file is created chmod 640 by bootstrap.sh; never paste these values into Git, logs or chat.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Redirect URIs are built with https:// whenever DJANGO_DEBUG=False. Only change for local testing.
# DJANGO_OAUTH_PROTOCOL=https

# --- Account emails ----------------------------------------------------------------
# Off ("disabled": recorded, never sent) until a sender is configured. See deploy/EMAIL.md.
# Set to smtp only after the sender domain is verified with the provider (SPF/DKIM).
BITETRACKER_EMAIL_DELIVERY=disabled
# Absolute address for links in emails; defaults to https://<first DJANGO_ALLOWED_HOSTS entry>.
BITETRACKER_SITE_URL=https://bitetracker.example.org
# Sender shown to recipients; the domain must be verified with the SMTP provider.
DEFAULT_FROM_EMAIL=BiteTracker <no-reply@bitetracker.example.org>
# Any SMTP provider, e.g. Amazon SES (email-smtp.<region>.amazonaws.com), Brevo, Mailgun,
# Google Workspace SMTP relay. Use a dedicated SMTP credential, NOT the Google sign-in secret.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Port 587 = STARTTLS (EMAIL_USE_TLS=True); port 465 = implicit TLS (EMAIL_USE_SSL=True). Not both.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Seconds; emails are sent inside the web request right after the database commit.
EMAIL_TIMEOUT=5
# Stop starting new sends in a web request after this many seconds (rest go to the retry command).
EMAIL_REQUEST_BUDGET_SECONDS=10
# Leave blank in normal operation. During a controlled test, list only addresses you own.
EMAIL_ALLOWED_RECIPIENTS=
# Retries via `deploy/scripts/manage.sh send_pending_emails` (cron/systemd timer).
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_MAX_AGE_HOURS=48

# --- State directory -------------------------------------------------------------
# SQLite database, trained model + metadata, processed historical CSV, metrics and
# user uploads live here, outside the code, so redeploys never touch them.
BITETRACKER_STATE_DIR=/var/lib/bitetracker

# --- Data ------------------------------------------------------------------------
# Not needed to serve forecasts: the web app reads the saved model and processed CSV.
# Only set this if you retrain on the server.
BITETRACKER_GOOGLE_SHEET_URL=
BITETRACKER_COST_PER_MEAL_KSH=
BITETRACKER_PLANNING_COST_PER_MEAL_KES=27

# --- Gunicorn (optional overrides of deploy/gunicorn.conf.py) ---------------------
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Backups (deploy/scripts/backup.sh) ---------------------------------------------
BACKUP_DIR=/var/backups/bitetracker
BACKUP_KEEP=14
# Optional off-instance copy, e.g. s3://my-bitetracker-backups/ec2 (bucket must be private).
BACKUP_S3_URI=
